//@version=6
// TMS - Trend Momentum Score (solo largo, gráfico DIARIO)
// Vota el momentum en 4 horizontes: ¿el cierre de hoy está sobre el de hace N días?
// COMPRA cuando >= 3 de 4 votos son positivos; VENDE cuando quedan <= 1.
// Entre medio mantiene la posición (histéresis = menos operaciones y comisiones).
// Para altcoins, el filtro de régimen exige además que BTC esté en señal de compra.
// Actuar solo con la vela diaria CERRADA (00:00 UTC). Backtest: trading/README.md
indicator("TMS - Trend Momentum Score", shorttitle = "TMS", overlay = false)

lb1       = input.int(30,  "Horizonte 1 (velas)", minval = 1)
lb2       = input.int(60,  "Horizonte 2 (velas)", minval = 1)
lb3       = input.int(120, "Horizonte 3 (velas)", minval = 1)
lb4       = input.int(240, "Horizonte 4 (velas)", minval = 1)
buyAt     = input.int(3, "Comprar con votos >=", minval = 1, maxval = 4)
sellAt    = input.int(1, "Vender con votos <=",  minval = 0, maxval = 3)
useRegime = input.bool(true, "Filtro de régimen BTC (para altcoins)")
btcSymbol = input.symbol("BITSTAMP:BTCUSD", "Símbolo de BTC para el filtro")

vote(float src, int n) =>
    src > src[n] ? 1 : 0

score(float src) =>
    vote(src, lb1) + vote(src, lb2) + vote(src, lb3) + vote(src, lb4)

tmsState(float src) =>
    var int pos = 0
    int s = score(src)
    if pos == 0 and s >= buyAt
        pos := 1
    else if pos == 1 and s <= sellAt
        pos := 0
    pos

int s      = score(close)
int ownPos = tmsState(close)
int btcPos = request.security(btcSymbol, timeframe.period, tmsState(close))
int pos    = useRegime ? ownPos * btcPos : ownPos

bool buySignal  = pos == 1 and pos[1] == 0
bool sellSignal = pos == 0 and pos[1] == 1

colScore = s >= buyAt ? color.new(color.teal, 0) : s <= sellAt ? color.new(color.red, 0) : color.new(color.gray, 0)
plot(s, "Votos positivos", color = colScore, style = plot.style_columns)
hline(buyAt,  "Umbral compra", color = color.teal, linestyle = hline.style_dashed)
hline(sellAt, "Umbral venta",  color = color.red,  linestyle = hline.style_dashed)
bgcolor(pos == 1 ? color.new(color.teal, 85) : na, title = "Comprado")
plotshape(buySignal,  "Compra", style = shape.triangleup,   location = location.bottom, color = color.teal, size = size.small)
plotshape(sellSignal, "Venta",  style = shape.triangledown, location = location.top,    color = color.red,  size = size.small)

alertcondition(buySignal,  "TMS compra", "TMS: COMPRA {{ticker}} al cierre {{close}}")
alertcondition(sellSignal, "TMS venta",  "TMS: VENTA {{ticker}} al cierre {{close}}")

var table info = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 20))
if barstate.islast
    table.cell(info, 0, 0, "Votos", text_color = color.white)
    table.cell(info, 1, 0, str.tostring(s) + "/4", text_color = color.white)
    table.cell(info, 0, 1, "Señal", text_color = color.white)
    table.cell(info, 1, 1, pos == 1 ? "COMPRADO" : "FUERA (USD)", text_color = pos == 1 ? color.lime : color.red)
    table.cell(info, 0, 2, "Régimen BTC", text_color = color.white)
    table.cell(info, 1, 2, btcPos == 1 ? "alcista" : "bajista", text_color = btcPos == 1 ? color.lime : color.red)
    if not timeframe.isdaily
        table.cell(info, 0, 0, "Usa gráfico DIARIO", text_color = color.orange)
